        <!-- KSA crashes on load if the system has no ocean at all (the ocean
             renderer makes a 0-byte buffer). This tiny ocean, buried inside
             the Sun with the Dummy, keeps that count above zero. -->
        <Ocean>
            <Level Km="0" />
            <MeshCollection Id="OceanEarth"/>
            <WindWaves>
                <MinWindSpeed Value="0.0" />
                <MaxWindSpeed Value="0.0" />
            </WindWaves>
            <GerstnerWaves>
                <Count Value="0" />
            </GerstnerWaves>
        </Ocean>

        <Height Id="Dummy_Height" Path="Textures/Dummy_Height.png" Category="TerrainHeight"/>

        <Terrain>
            <BiomeMaterials>
                <BiomeMaterial Biome="Surface">
                    <GroundMaterial>
                        <Diffuse Id="LunaGroundDiffuse" Path="Textures/Luna_Albedo.dds" Category="Terrain"/>
                        <Normal Id="LunaGroundNormal" Path="Textures/Luna_Normal.dds" Category="Terrain"/>
                        <AoRoughMetal Id="LunaGroundAoRoughMetal" Path="Textures/Luna_AoRoughMetal.dds" Category="Terrain"/>
                        <Displacement Id="LunaGroundDisplacement" Path="Textures/Luna_Displacement.dds" Category="Terrain"/>
                    </GroundMaterial>

                    <SlopeMaterial>
                        <Diffuse Id="LunaCliffsDiffuse" Path="Textures/Luna_Cliffs_Albedo.dds" Category="Terrain"/>
                        <Normal Id="LunaCliffsNormal" Path="Textures/Luna_Cliffs_Normal.dds" Category="Terrain"/>
                        <AoRoughMetal Id="LunaCliffsAoRoughMetal" Path="Textures/Luna_Cliffs_AoRoughMetal.dds" Category="Terrain"/>
                        <Displacement Id="LunaCliffsDisplacement" Path="Textures/Luna_Cliffs_Displacement.dds" Category="Terrain"/>
                    </SlopeMaterial>
                </BiomeMaterial>
            </BiomeMaterials>
        </Terrain>
    </AtmosphericBody>
